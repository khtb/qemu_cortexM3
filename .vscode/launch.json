{
  "version": "0.2.0",
  "configurations": [
    {
      /* cortex-debug is extentionn */
      "name": "C/C++ Runner: Debug Session",
      "type": "cortex-debug",
      "request": "launch",
      "executable": "${workspaceFolder}/out/app.elf",
      "servertype": "external",
      "gdbTarget": "localhost:1234",
      "device": "Cortex-M3" ,
      "runToEntryPoint": "main",
      "showDevDebugOutput": "raw",
      "preLaunchTask": "LaunchQemu",
      "postDebugTask": "killQemu"
    }
  ]
}